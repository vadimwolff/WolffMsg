# ─────────────────────────────────────────────────────────────────────────────
# WolffMsg — environment template
#
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Generate strong secrets with:  openssl rand -base64 48
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Public origin of the web client. Used for CORS and cookie scoping.
# Multiple origins may be comma-separated.
WEB_ORIGIN=http://localhost:5173

# Public URL the API is reachable at (used for push notification links).
PUBLIC_URL=http://localhost:5173

# Set to `true` only when the app is served over HTTPS. Controls the
# `Secure` flag on session cookies.
COOKIE_SECURE=false

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://wolff:CHANGE_ME@localhost:5432/wolffmsg?schema=public
# Separate database used by the integration test suite.
TEST_DATABASE_URL=postgresql://wolff:CHANGE_ME@localhost:5432/wolffmsg_test?schema=public

# ── Redis ────────────────────────────────────────────────────────────────────
# Used for rate limiting, presence and cross-node realtime fan-out.
# Leave empty to fall back to a single-process in-memory implementation
# (development only — does not scale beyond one server instance).
REDIS_URL=redis://localhost:6379

# ── Secrets ──────────────────────────────────────────────────────────────────
# 32+ bytes of entropy. Used to derive the session-token pepper and the
# CSRF signing key. Rotating this invalidates every active session.
SESSION_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48

# ── Attachment storage ───────────────────────────────────────────────────────
# `local` writes encrypted blobs to STORAGE_PATH.
# Blobs are always client-side encrypted before they reach the server.
STORAGE_DRIVER=local
STORAGE_PATH=./storage
# Maximum encrypted attachment size in bytes (default 100 MiB).
MAX_ATTACHMENT_BYTES=104857600
# Maximum avatar size in bytes (default 4 MiB).
MAX_AVATAR_BYTES=4194304

# ── WebRTC (voice / video calls) ─────────────────────────────────────────────
# Comma-separated STUN servers.
STUN_SERVERS=stun:stun.l.google.com:19302
# TURN relay for peers behind symmetric NAT. Leave blank to disable.
TURN_SERVER=
TURN_USERNAME=
TURN_PASSWORD=

# ── Web Push (VAPID) ─────────────────────────────────────────────────────────
# Generate a keypair with:  npx web-push generate-vapid-keys
# Leave blank to disable push notifications entirely.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ── Logging ──────────────────────────────────────────────────────────────────
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ── Registration ─────────────────────────────────────────────────────────────
# Set to `false` to close public sign-ups on a private deployment.
ALLOW_REGISTRATION=true
