node_modules/
dist/
build/
coverage/
.vite/
*.tsbuildinfo

# Environment / secrets — never commit real values
.env
.env.*
!.env.example

# Local runtime state.
#
# Anchored with a leading slash, or named in full. A bare `storage/` matches a
# directory of that name at ANY depth — which silently swallowed
# `packages/server/src/storage/`, the blob-writing source code, so the
# repository built locally and failed everywhere else.
/storage/
/uploads/
/logs/
packages/server/storage/
packages/server/uploads/
*.log
npm-debug.log*

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Prisma local artifacts
packages/server/prisma/*.db
packages/server/prisma/*.db-journal

# Redis local dump
dump.rdb
